# Copy to .env.local for development, or set these in the Vercel project and redeploy.

# Where the live BotForge Cloud product lives. The console reads every screen from
# {BOTFORGE_API_URL}/api/admin/data — there are no local fixtures to fall back on.
BOTFORGE_API_URL=https://botforge-cloud.vercel.app

# Operator credential this deployment uses to mint its own product session.
# Defaults to ADMIN_USERNAME / ADMIN_PASSWORD when unset. Useful when the product
# operator username differs from the console login username.
BOTFORGE_OPERATOR_USERNAME=
BOTFORGE_OPERATOR_PASSWORD=

# Optional fallback so /login still opens if the product itself is unreachable.
# Values are read at runtime only; never commit real ones.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=

# 32+ random characters — signs the console session cookie. openssl rand -hex 32
ADMIN_SESSION_SECRET=
